+                         {"i": item_id}).mappings().one()
+        job = s.execute(text("""
+            SELECT status, attempt_count, locked_at, last_error FROM processing_jobs
+            WHERE content_id = (SELECT content_id FROM items WHERE id = :i)"""),
+                        {"i": item_id}).mappings().one()
+    return dict(item), dict(job)
