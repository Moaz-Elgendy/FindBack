# Copy to .env and fill values
# Backend
DATABASE_URL=postgresql://findback:findback@postgres:5432/findback
REDIS_URL=redis://redis:6379/0
API_SECRET_KEY=change-me-32-chars
DEV_AUTH_ENABLED=true
DEV_AUTH_EMAIL=dev@findback.local
JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:8081
# LLM / Embeddings
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
EXTRACTOR_MODEL=gpt-4o-mini
# Scraping
FIRECRAWL_API_KEY=fc-...
JINA_READER_ENABLED=true
# Storage (S3/R2)
S3_ENDPOINT=
S3_BUCKET=findback-raw
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Auth (Supabase)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Search
RRF_K=60
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3
# Mobile
EXPO_PUBLIC_API_URL=http://localhost:8000
