# Copy to .env and fill values
# Backend
DATABASE_URL=postgresql://findback:findback@postgres:5432/findback
REDIS_URL=redis://redis:6379/0
API_SECRET_KEY=change-me-32-chars
DEV_AUTH_ENABLED=true
DEV_AUTH_EMAIL=dev@findback.local
JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:8081
# --- AI providers ------------------------------------------------------------
# Chat provider for extraction: groq | gemini | openai | openai_compatible.
# Leave unset to auto-detect from whichever key below is filled in, trying
# groq, then gemini, then openai.
AI_PROVIDER=
# Optional chat fallback after primary 429/503/timeout retries are exhausted.
# Uses the selected provider key below; AI_MAX_RETRIES caps attempts per provider.
SECONDARY_AI_PROVIDER=
SECONDARY_AI_MODEL=
# --- Model selection ---------------------------------------------------------
# There are exactly two model roles, and one variable each. Anything left empty
# here falls back to the built-in default for whichever provider is resolved,
# which is exactly what happened before these variables existed.
#
# AI_MODEL: the chat/text model. Used for brief extraction and for the
# `scripts/check_ai.py` connectivity probe.
#   default: groq openai/gpt-oss-120b | gemini gemini-3.8-flash
#            | openai gpt-4o-mini | openai_compatible gpt-4o-mini
#   example: AI_MODEL=gemini-3.5-flash-preview
# Models get retired by the provider; a rejected id is logged verbatim, so
# moving to a newer Flash version is a pure .env change - no code change.
AI_MODEL=
# EXTRACTOR_MODEL: the older name for the same role. Still read, so an .env
# written against it keeps the model it asked for; AI_MODEL wins if both are set.
EXTRACTOR_MODEL=
# EMBEDDING_MODEL: the embedding model, resolved separately from the chat one.
#   default: gemini gemini-embedding-001 | openai text-embedding-3-small
#            | openai_compatible text-embedding-3-small | groq nomic-embed-text-v1_5
#
#  !! WARNING: changing this invalidates every vector already stored. Vectors
#  from the old model and the new model are scored against the same query
#  vector, so search silently returns nonsense for anything saved before the
#  switch (items.embedding_model is recorded per row, but search does not filter
#  on it -- only the content-reuse path does). There is no re-embed tool yet, so
#  treat this as a fresh-start setting: re-save your memories, or leave it alone.
#  Also keep EMBEDDING_DIMS in step with the model -- see below.
EMBEDDING_MODEL=
# --- Provider API keys -------------------------------------------------------
# One key per provider. Fill in at least one or FindBack runs fully offline
# (heuristic brief, keyword-only search), which still works.
# Groq - https://console.groq.com/keys  (chat only: see EMBEDDING_PROVIDER)
GROQ_API_KEY=
# Google AI Studio - https://aistudio.google.com/apikey  (chat + embeddings).
# GEMINI_API_KEY is the documented name. GOOGLE_API_KEY is an accepted alias
# for the very same key and is only read when GEMINI_API_KEY is empty -- it is
# not a different credential, so set one, not both.
GEMINI_API_KEY=
GOOGLE_API_KEY=
# OpenAI, or any OpenAI-compatible server (Ollama, vLLM, OpenRouter) by also
# pointing OPENAI_BASE_URL at it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
# --- Embeddings --------------------------------------------------------------
# Set separately from AI_PROVIDER on purpose: no Groq model matches the
# 1536-wide pgvector column in models.py, so a Groq-only setup should let
# Gemini do the embedding, or run with no embeddings at all (search then
# falls back to BM25/keyword recall, which still works).
# Unset = reuse the chat provider when it supports embeddings.
EMBEDDING_PROVIDER=
# Must match Vector(1536) in models.py and migration 0001, and the width your
# embedding model actually returns. A mismatch is caught before the insert (the
# vector is dropped, no row written) rather than silently mis-scored.
EMBEDDING_DIMS=1536
# Max contents per embedding request (Gemini's documented ceiling is 100).
EMBEDDING_BATCH_SIZE=96
# L2-normalise truncated Gemini vectors, as Google's docs require.
EMBEDDING_NORMALIZE=true
# --- AI reliability knobs ----------------------------------------------------
# Per-request HTTP timeout for every provider call, seconds.
AI_TIMEOUT_SECONDS=45
# Total attempts per request (1 + retries). Retries cover timeouts, 429 and 5xx.
AI_MAX_RETRIES=3
# Cumulative backoff budget per provider call. If Retry-After exceeds the
# remaining budget, stop retries and allow configured chat failover.
AI_RETRY_WAIT_BUDGET_SECONDS=120
# Send response_format={"type":"json_object"}; auto-dropped if refused.
AI_USE_JSON_MODE=true
# Cap on the extraction completion, so a rambling model cannot hold a request.
EXTRACTOR_MAX_TOKENS=900
# Max characters of page text sent for extraction (default 8000).
EXTRACTOR_MAX_CHARS=
# Max characters per embedded string (default 8000).
EMBED_MAX_CHARS=
# Log full provider request/response bodies (they contain saved page text).
AI_DEBUG=false

# --- Pipeline concurrency and rate limits (Phase 7) --------------------------
# Simultaneous outbound calls per stage. Separate on purpose: embedding is a
# batched, token-heavy call and must not crowd out fetching.
FETCH_CONCURRENCY=4
AI_CONCURRENCY=4
EMBEDDING_CONCURRENCY=2
# Sustained chat calls per second, and the burst allowed above that.
AI_RATE_PER_SEC=5
AI_BURST=10
# Failed attempts a queued processing job gets before it is parked FAILED.
JOB_MAX_ATTEMPTS=5
# Seconds between outbox dispatcher ticks. The dispatcher is the only thing
# that republishes a job a queue outage stranded; it runs as the `outbox`
# service in docker-compose.yml, or as `python -m scripts.dispatch_outbox`.
OUTBOX_DISPATCH_INTERVAL_SECONDS=5
# Scraping
FIRECRAWL_API_KEY=fc-...
JINA_READER_ENABLED=true
# Storage (S3/R2)
S3_ENDPOINT=
S3_BUCKET=findback-raw
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Region for the S3/R2 client. "auto" is what Cloudflare R2 expects.
S3_REGION=auto
# Auth (Supabase)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Where the verified-email signal is read from, as a dotted claim path.
# Must NOT point into user_metadata: users can write that themselves, so it
# proves nothing. Default: app_metadata.email_verified
AUTH_EMAIL_VERIFIED_CLAIM=app_metadata.email_verified
# Search
RRF_K=60
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3
# Phase 12 ranking: how much a chunk hit counts, and how much a recent save
# may lift a result (recency is a tie-breaker, so keep it tiny).
CHUNK_VECTOR_WEIGHT=0.5
CHUNK_LEXICAL_WEIGHT=0.35
# The user's own note and intent as a candidate source. Above a body-word
# match, below the memory's own vector.
NOTE_LEXICAL_WEIGHT=0.45
RECENCY_WEIGHT=0.001

# Retention: how long the fetched page (raw_text/normalized_text) is kept.
# 0 (the default) drops it as soon as the pipeline has finished; the brief,
# chunks and vectors are kept while the memory exists.
RAW_TEXT_RETENTION_HOURS=0

# Schema bootstrap on API startup: migrate | create | none
# migrate (default) runs `alembic upgrade head` in-process.
# create only makes sense against a throwaway DB — it writes no migration history.
SCHEMA_BOOTSTRAP=migrate

# Mobile (Flutter)
# These are NOT secrets and are NOT read from this file at runtime: pass them to
# the app with --dart-define (see README) or flutter --define from a .env file.
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000 \
#             --dart-define=SUPABASE_URL=https://xxxx.supabase.co \
#             --dart-define=SUPABASE_ANON_KEY=<public anon key>
API_BASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=

# --- Tests -------------------------------------------------------------------
# Read only by backend/tests: the live-DB tests create and drop throwaway
# databases here, and skip themselves when it is unset. Point it at a Postgres
# whose role may CREATE DATABASE.
TEST_DATABASE_URL=postgresql://findback:findback@localhost:5432/fb_brief_upgrade


# Brief v2 worker media (see docs/BRIEF_V2.md)
MEDIA_ENABLED=true
MEDIA_MAX_DURATION_SECONDS=1200
MEDIA_LONG_MAX_SECONDS=7200
MEDIA_MAX_FILESIZE_MB=150
MEDIA_FRAME_CAP=10
MEDIA_FFMPEG_TIMEOUT=300
MEDIA_OCR_LANGUAGES=eng+ara
MEDIA_COOKIES_PATH=
MEDIA_RETRY_MAX_ATTEMPTS=3
MEDIA_RETRY_BASE_SECONDS=30
STT_PROVIDER=local
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LONG_PROVIDER=cloud
STT_CLOUD_BASE_URL=
STT_CLOUD_API_KEY=
STT_CLOUD_MODEL=whisper-1
STT_CLOUD_TIMEOUT=180
STT_CLOUD_COST_PER_MINUTE=
BRIEF_NORMAL_MODEL=
BRIEF_COMPLEX_MODEL=
BRIEF_MAX_TOKENS=2400
BRIEF_CHUNK_CHARS=12000
BRIEF_INPUT_COST_PER_MILLION=
BRIEF_OUTPUT_COST_PER_MILLION=
