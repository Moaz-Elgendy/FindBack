# Absolute machine paths written by the Flutter tooling / Gradle. Committing
# these breaks every other machine's build.
mobile/.idea/
mobile/android/local.properties
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/flutter_export_environment.sh
# Generated per developer machine by tool/setup_mobile.sh, so `git add mobile/`
# stays clean. Drop the android/ (and ios/) line when the native share-intake
# work lands — an intent-filter / Share Extension target has to be checked in.
mobile/android/
mobile/ios/
mobile/linux/
mobile/macos/
mobile/windows/
mobile/web/

# Scratch output from local test runs. These are not part of the repo: they
# were committed once by accident and removed again.
*.log
test_output.txt
dart_test_output.txt
