.env
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.expo/
dist/
*.db
celerybeat-schedule
.coverage
.pytest_cache/
.DS_Store

# Flutter / Dart
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/.packages
mobile/pubspec.lock
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/android/.gradle/
mobile/**/*.g.dart
mobile/**/*.freezed.dart
# Absolute machine paths written by the Flutter tooling / Gradle. Committing
# these breaks every other machine's build.
mobile/.idea/
mobile/android/local.properties
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/flutter_export_environment.sh
# Generated per developer machine by tool/setup_mobile.sh, so `git add mobile/`
# stays clean. Drop the android/ (and ios/) line when the native share-intake
# work lands — an intent-filter / Share Extension target has to be checked in.
mobile/android/**
!mobile/android/app/
!mobile/android/app/src/
!mobile/android/app/src/main/
!mobile/android/app/src/main/AndroidManifest.xml
!mobile/android/app/src/main/kotlin/
!mobile/android/app/src/main/kotlin/com/
!mobile/android/app/src/main/kotlin/com/findback/
!mobile/android/app/src/main/kotlin/com/findback/findback/
!mobile/android/app/src/main/kotlin/com/findback/findback/MainActivity.kt
mobile/ios/**
!mobile/ios/Runner/
!mobile/ios/Runner/AppDelegate.swift
mobile/linux/
mobile/macos/
mobile/windows/
mobile/web/

# Scratch output from local test runs. These are not part of the repo: they
# were committed once by accident and removed again.
*.log
test_output.txt
dart_test_output.txt

# `termination/` holds files moved out of the project rather than deleted, so
# they stay recoverable with `git mv termination/<path> <path>`. The moves are
# already committed, so this only stops the folder being tracked going forward.
# It also keeps it out of the test and build paths: pytest runs from backend/
# (`testpaths = tests`), flutter from mobile/, and the Docker build context is
# ./backend, so none of them reach the repository root in the first place.
termination/

# Native reminder configuration is source, not generated output.
!mobile/android/app/build.gradle.kts
!mobile/android/app/src/main/res/
!mobile/android/app/src/main/res/drawable/
!mobile/android/app/src/main/res/drawable/ic_notification.xml
